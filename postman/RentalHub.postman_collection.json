              "raw": "{\n  \"type\": \"VILLA\",\n  \"title\": \"Quiet garden villa, renamed\",\n  \"description\": \"A calm hideaway with a shaded garden, hammocks and birdsong. No traffic, no crowds; the beach is a ten minute walk down a lane.\",\n  \"city\": \"Goa\",\n  \"country\": \"India\",\n  \"pricePerNight\": 9000,\n  \"currency\": \"INR\",\n  \"maxGuests\": 6,\n  \"bedrooms\": 3,\n  \"bathrooms\": 2,\n  \"attributes\": { \"plotAreaSqm\": \"500\", \"hasPool\": \"true\" }\n}",
