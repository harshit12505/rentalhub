            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Search($filter: SearchFilter) {\n  searchProperties(filter: $filter) {\n    totalElements\n    content {\n      id title typeLabel pricePerNight currency\n      host { fullName }\n      images { url }\n    }\n  }\n}",
                "variables": "{\n  \"filter\": { \"city\": \"goa\" }\n}"
              }
