{
  "info": {
    "name": "RentalHub",
    "description": "Every RentalHub endpoint, REST and GraphQL, in an order that works from top to bottom on a fresh database: run the folders in order, and ids created by one request are saved for the next.\n\nImport this file and postman/RentalHub.local.postman_environment.json, choose the \"RentalHub local\" environment, and set hostId and guestId to a HOST and a GUEST user (the hands-on guide creates them as 1 and 2).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listings",
      "item": [
        {
          "name": "Search listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?city=goa&guests=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "goa"
                },
                {
                  "key": "guests",
                  "value": "2"
                }
              ]
            },
            "description": "Active listings, newest first. Every filter is optional."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search under $100 a night, prices in USD",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?maxPrice=100&currency=USD",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "maxPrice",
                  "value": "100"
                },
                {
                  "key": "currency",
                  "value": "USD"
                }
              ]
            },
            "description": "maxPrice is read in currency and compared with each listing in its own currency."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a listing (host)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User-Id",
                "value": "{{hostId}}",
                "description": "Who is acting."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ]
            },
            "description": "As the host. Saves the new listing's id as {{propertyId}} for the requests after it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"VILLA\",\n  \"title\": \"Quiet garden villa\",\n  \"description\": \"A calm hideaway with a shaded garden, hammocks and birdsong. No traffic, no crowds; the beach is a ten minute walk down a lane.\",\n  \"city\": \"Goa\",\n  \"country\": \"India\",\n  \"pricePerNight\": 9000,\n  \"currency\": \"INR\",\n  \"maxGuests\": 6,\n  \"bedrooms\": 3,\n  \"bathrooms\": 2,\n  \"attributes\": { \"plotAreaSqm\": \"500\", \"hasPool\": \"true\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('propertyId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "One listing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}?currency=USD",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties",
                "{{propertyId}}"
              ],
              "query": [
                {
                  "key": "currency",
                  "value": "USD"
                }
              ]
            },
            "description": "Add ?currency=USD to also see the price converted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
