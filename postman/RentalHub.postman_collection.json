    {
      "name": "Photos",
      "item": [
        {
          "name": "Upload a photo (host)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User-Id",
                "value": "{{hostId}}",
                "description": "Who is acting."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{propertyId}}/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties",
                "{{propertyId}}",
                "images"
              ]
            },
            "description": "multipart/form-data with the photo in a part called file. Needs S3 (or MinIO) configured: without it the answer is a 503 that says so. In Postman, set Settings > General > Working directory to the repository folder so samples/api/photo.jpg is found.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/api/photo.jpg"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('imageId', pm.response.json().id);",
                  "  pm.collectionVariables.set('imageFile', pm.response.json().url.split('/').pop());",
                  "}",
                  "pm.test('stored, or storage not configured', () => pm.expect(pm.response.code).to.be.oneOf([201, 503]));"
                ]
              }
            }
          ]
        },
        {
          "name": "A photo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/images/listings/{{propertyId}}/{{imageFile}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "images",
                "listings",
                "{{propertyId}}",
                "{{imageFile}}"
              ]
            },
            "description": "The bytes of an uploaded photo, served by the app. Run the upload first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove a photo (host)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Demo-User-Id",
                "value": "{{hostId}}",
