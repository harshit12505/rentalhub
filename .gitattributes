# Normalise line endings in the repository; check out with the platform's native ones.
* text=auto

# Shell scripts must keep LF endings even on Windows, or they break inside the
# Linux Docker build ("/bin/sh^M: bad interpreter").
mvnw    text eol=lf
*.sh    text eol=lf

# Windows batch files need CRLF.
*.cmd   text eol=crlf
*.bat   text eol=crlf
